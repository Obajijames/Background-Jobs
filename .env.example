# PostgreSQL connection string (PDF job system)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pdf_jobs"

# Worker concurrency: max jobs processed at once per worker process
WORKER_CONCURRENCY=3

# Retry limit: total attempts before a job transitions to dead
JOB_MAX_ATTEMPTS=5

# Exponential backoff: base delay for the first retry, in ms
JOB_BACKOFF_BASE_MS=1000

# Maximum added random jitter per retry, in ms (uniform in [0, JOB_BACKOFF_JITTER_MS))
JOB_BACKOFF_JITTER_MS=500

# A job stuck in processing longer than this (ms) is recovered back to pending
JOB_STUCK_TIMEOUT_MS=60000

# Where generated PDFs are written
PDF_OUTPUT_DIR=output

# Worker poll cadence in ms
WORKER_POLL_INTERVAL_MS=1000

# Identifier used for claim/log attribution
WORKER_ID=worker-default

# Test-only failure switch: when non-empty, makes jobs fail for break-it testing.
# Must be empty for normal operation.
PDF_TEST_FAIL=